{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RP6502-WEB",
            "type": "debugpy",
            "request": "launch",
            "console": "internalConsole",
            "module": "http.server",
            "args": [
                "--bind",
                "127.0.0.1",
                "--directory",
                "${command:cmake.buildDirectory}/web",
                "0"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "preLaunchTask": "CMake: build",
            "serverReadyAction": {
                "pattern": "\\((https?://\\S+)\\)",
                "uriFormat": "%s",
                "action": "openExternally"
            },
        }
    ]
}
