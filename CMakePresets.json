{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_FLAGS_DEBUG": "-g -O",
                "CMAKE_C_FLAGS_RELEASE": "-O -DNDEBUG"
            },
            "generator": "Ninja"
        },
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "description": "cc65, with debug information",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "description": "cc65, optimized",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "configurePreset": "cc65/Debug",
            "targets": [
                "all"
            ]
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "configurePreset": "cc65/Release",
            "targets": [
                "all"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "cc65/Debug",
            "configurePreset": "cc65/Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "cc65/Release",
            "configurePreset": "cc65/Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
